<% if event_participant.status == "yes" %>
  <tr style="background-color: #85ffc4;">
<% elsif event_participant.status == "maybe" %>
  <tr style="background-color:#fdd979;">
<% else %>
  <tr style="background-color:#fe7171;">
<% end %>

<% if current_user.morg? and (not @edit_participants) %>
  <td>
  <%= link_to event_participant.participant.id, act_participant_path(event_participant.participant_id) %>
  </td>
<% end %>

<% if current_user.org? %>
  <% if @edit_participants %>
    <td>
    <%= event_participant.participant.name %>
    <%= event_participant.participant.last_name %>
    </td>
  <% else %>
    <td>
    <%= event_participant.participant.name %>
    </td>

    <td>
    <%= event_participant.participant.last_name %>
    </td>

    <% if event_participant.event.paper_template.present? %>
      <td> <%= link_to "papiry", act_event_papers_please_path(@event.id, event_participant.participant.id) %></td>
    <% end %>

    <td>
    <%= event_participant.participant.nickname %>
    </td>
  <% end %>
<% else %>
  <td>
  <%= event_participant.participant.partial_name %>
  </td>
<% end %>

<% if @edit_participants %>
  <%= form_for :event_participant, :url => act_event_update_participant_path(event_participant.event_id, event_participant.participant_id) do |f| %>
    <% f.hidden_field :participant_id %>
    <% f.hidden_field :event_id %>
    <td>
    <%= f.select :status, [["Ano", "yes"], ["Možná", "maybe"], ["Ne", "no"]], :selected => event_participant.status %>
    </td>
    <td>
    <%= f.text_field :note, :size=>"15", :value => event_participant.note %>
    </td>
    <% if event_participant.event.spec_place %>
      <td>
        <%= f.text_field :place, :size=>"7", :value => event_participant.place %>
      </td>
    <% end %>
    <% if event_participant.event.spec_place_return %>
      <td>
        <%= f.text_field :place_return, :size=>"7", :value => event_participant.place_return %>
      </td>
    <% end %>

    <% if event_participant.event.spec_participant %>
      <td>
        <%= f.text_field :participant_info, :size=>"15", :value => event_participant.participant_info %>
      </td>
    <% end %>

    <% if event_participant.event.spec_mass %>
      <td>
        <%= f.select :mass, [["Ano", true], ["Ne", false]], :selected => event_participant.mass %>
      </td>
    <% end %>
    <td>
    <%= f.submit "Uložit", :class => 'btn btn-primary' %>
    </td>
  <% end %>

  <% if can? :delete, Act::EventParticipant %>
    <td>
    <%= form_tag act_event_delete_participant_path(event_participant.event_id, event_participant.participant_id) do %>
      <%= submit_tag 'Odhlásit', :class=>'btn btn-danger' %>
    <% end %>
    </td>
  <% end %>

  <% if (can? :update, Act::EventParticipant) %>
    <td>
    <% if event_participant.substitute? %>
      <%= render :partial => "act/events/form_choose_participant", locals: { event: event_participant.event, participant: event_participant.participant, chosen: "participant", text: "Účastník", btn_class: "btn btn-success" } %>
    <% else %>
      <%= render :partial => "act/events/form_choose_participant", locals: { event: event_participant.event, participant: event_participant.participant, chosen: "substitute", text: "Náhradník", btn_class: "btn btn-warning" } %>
    <% end %>
    </td>
  <% end %>
<% else %>
  <td>
  <%= event_participant.note %>
  </td>

  <% if event_participant.event.spec_place %>
    <% if current_user.org? || event_participant.participant.is_me?(current_user) %>
      <td>
      <%= event_participant.place %>
      </td>
    <% else %>
      <td style="background-color:#dcdcdc;">
      </td>
    <% end %>
  <% end %>

  <% if event_participant.event.spec_place_return %>
    <% if current_user.org? || event_participant.participant.is_me?(current_user) %>
      <td>
      <%= event_participant.place_return %>
      </td>
    <% else %>
      <td style="background-color:#dcdcdc;">
      </td>
    <% end %>
  <% end %>

  <% if event_participant.event.spec_participant %>
    <% if current_user.org? || event_participant.participant.is_me?(current_user) %>
      <td>
      <%= event_participant.participant_info %>
      </td>
    <% else %>
      <td style="background-color:#dcdcdc;">
      </td>
    <% end %>
  <% end %>

  <% if event_participant.event.spec_mass %>
    <% if current_user.org? || event_participant.participant.is_me?(current_user) %>
      <td>
        <% if event_participant.mass %>
          <span class="ace-icon fa fa-plus"></span>
        <% end %>
      </td>
    <% else %>
      <td style="background-color:#dcdcdc;">
      </td>
    <% end %>
  <% end %>
<% end %>

</tr>
