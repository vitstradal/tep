<% if current_user.org? %>
<tr>

<% num_org_attributes = 4 + (current_user.morg? && (not @edit_participants) ? 1 : 0) - (@edit_participants ? 3 : 0) + (@event.paper_template.present? ? 1 : 0) %>
<td colspan="<%= num_org_attributes %>" style="text-align: center;">
org only
</td>
<% num_user_attributes = 2  %>
<td colspan="<%= num_user_attributes %>" style="text-align: center;">
user only
</td>
<% num_electible_attributes = (@edit_participants ? 4 : 0) + (@event.spec_place ? 1 : 0) + (@event.spec_place_return ? 1 : 0) + (@event.spec_participant ? 1 : 0) + (@event.spec_mass ? 1 : 0) %>
<% if num_electible_attributes > 0 %>
<td colspan="
<%= num_electible_attributes %>
" style="text-align: center;">
org only
</td>
<% end %>
</tr>
<% end %>
<tr>
<% if current_user.morg? and (not @edit_participants) %>
<th>
ID
</th>
<% end %>
<% if current_user.org? %>
<% if @edit_participants %>
<th>Jméno a příjmení</th>
<% else %>
<th>Jméno</th>
<th>Příjmení</th>
<th title="Ročník">R.</th>
<th title="Pohlaví">P.</th>
<% if @event.paper_template.present? %><th>Papíry</th> <% end %>
<% end %>
<% end %>
<% unless @edit_participants %><th>Přezdívka</th><% end %>
<% if @edit_participants %><th>Účast</th><% end %>
<th>Poznámka</th>
<% if @event.spec_place %>
<th>Nástup</th>
<% end %>
<% if @event.spec_place_return %>
<th>Návrat</th>
<% end %>
<% if @event.spec_participant %>
<th>Info k účastníkovi</th>
<% end %>
<% if @event.spec_mass %>
<th>Mše</th>
<% end %>
<% if @edit_participants %>
<th colspan="4" style="text-align: center;">
Akční tlačítka
</th>
<% end %>
</tr>
