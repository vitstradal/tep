<h1>Účastníci akce
  <%= @event.title %>
</h1>

<% toggle = ->(cls, on, text, data = {}) { content_tag(:button, text, type: 'button', class: "btn btn-xs #{on ? 'btn-primary' : 'btn-white'} #{cls}", data: data) } %>
<div id="act_display_controls" data-view="<%= { col: @view[:col].map { |c| c ? 1 : 0 }.join, org: @view[:org] ? 1 : 0, par: @view[:par] ? 1 : 0, sub: @view[:sub] ? 1 : 0, yes: @view[:yes] ? 1 : 0, no: @view[:no] ? 1 : 0, maybe: @view[:maybe] ? 1 : 0, sort: @view[:sort], empty: @view[:empty] }.to_json %>" data-attrs="<%= @attr_table.size %>">
  <p>
    <b>Sloupce:</b>
    <% @attr_table.each_with_index do |attr, index| %>
      <%= toggle.('toggle-vis', @view[:col][index], attr[1], column: index) %>
    <% end %>
  </p>
  <p>
    <b>Kdo:</b>
    <span class="btn-group">
      <%= toggle.('toggle-group', @view[:par], 'účastníci', group: 'par') %>
      <%= toggle.('toggle-group', @view[:sub], 'náhradníci', group: 'sub') %>
      <%= toggle.('toggle-group', @view[:org], 'orgové', group: 'org') %>
    </span>
    <span class="btn-group">
      <%= toggle.('toggle-group', @view[:yes], 'jede', group: 'yes') %>
      <%= toggle.('toggle-group', @view[:maybe], 'možná', group: 'maybe') %>
      <%= toggle.('toggle-group', @view[:no], 'nejede', group: 'no') %>
    </span>
    <button type="button" class="btn btn-xs btn-white clear-vis">jen příjmení a jméno</button>
  </p>
  <p>
    <b>Řadit podle:</b>
    <span class="btn-group">
      <% Act::EventsController::DISPLAY_SORTS.each do |key, sort| %>
        <%= toggle.('set-sort', @view[:sort] == key, sort[:text], sort: key) %>
      <% end %>
    </span>
    &nbsp; <b>Prázdné sloupce:</b>
    <span class="btn-group">
      <% (0..Act::EventsController::DISPLAY_MAX_EMPTY).each do |n| %>
        <%= toggle.('set-empty', @view[:empty] == n, n.to_s, empty: n) %>
      <% end %>
    </span>
  </p>
  <%= button_tag 'download CSV', :class=>'download-csv btn btn-primary', :href => "?fmt=csv", ico: 'fa-excel' %>
  <%= button_tag 'download PDF', :class=>'download-pdf btn btn-primary', :href => "?fmt=pdf", ico: 'fa-pdf' %>
  <%= button_tag 'download PDF landscape', :class=>'download-pdfl btn btn-primary', :href => "?fmt=pdfl", ico: 'fa-pdf' %>
  <br/><br/>
</div>

<div class="table-div">
  <table id="act_display_participants">
    <thead>
    <tr>
      <% for attr in @attr_table do %>
        <td><b><%= attr[1] %></b></td>
      <% end %>
      <% @view[:empty].times do %>
        <td style="min-width:6em"></td>
      <% end %>
    </tr>
    </thead>
    <tbody>
    <% [['org', 'Organizátoři', [@orgs_yes, @orgs_maybe, @orgs_no]],
        ['par', 'Účastníci', [@parts_yes, @parts_maybe, @parts_no]],
        ['sub', 'Náhradníci', [@substitutes_yes, @substitutes_maybe, @substitutes_no]]].each do |group, title, lists| %>
      <tr data-group="<%= group %>">
        <% for attr in @attr_table do %>
          <td><b><%= title %></b></td>
        <% end %>
        <% @view[:empty].times do %><td></td><% end %>
      </tr>
      <% lists.each do |list| %>
        <%= render :partial => "display_participants_single_type", locals: { event_participants: list } %>
      <% end %>
    <% end %>
    </tbody>
  </table>
</div>
