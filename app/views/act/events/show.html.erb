
<div class="tabbable">
  <ul id="myTab" class="nav nav-tabs">
     <li class="active" > <%= link_to 'Přihlašování',   "#"   %></li>
     <% if @event.event_info_url != "" %>
        <li> <%= link_to 'Informace',    @event.event_info_url  %></li>
     <% end %>
     <% if @event.event_photos_url != "" %>
        <li> <%= link_to 'Fotky', @event.event_photos_url  %></li>
     <% end %>
  </ul>
  <div class="tab-content">

<h1><%= @event.title %>
<% if (can? :edit, Act::Event) && !@edit_participants %>
  <%= button_tag "Edituj akci", :href => act_event_edit_path(@event), :class=>'btn btn-warning', :ico => 'fa-wrench' %>
<% end %>
<% if @edit_participants %>
    <%= button_tag "Zpět", :href => act_event_path(@event), :class=>'btn', :ico =>'fa-reply' %>
<% else %>
  <% if can? :update_other, Act::EventParticipant %>
    <%= button_tag "Edituj účastníky", :href => act_event_edit_participants_path(@event), :class=>'btn btn-danger', :ico => 'fa-pencil-square-o ' %>
    <%= button_tag "Přihlaš nové účastníky", :href => act_event_enroll_others_path(@event, "ev", "ev"), :class=>'btn btn-success', :ico => 'fa-users' %>
  <% end %>
<% end %>
<% if (can? :edit, Act::EventInvitation) && !@edit_participants && (@event.enable_only_specific_participants || @event.enable_only_specific_substitutes || @event.enable_only_specific_organisers) %>
  <%= button_tag "Edituj pozvané", :href => act_event_edit_invitations_path(@event), :class=>'btn btn-warning', :ico => 'fa-envelope' %>
<% end %>
</h1>

<% if @event.errors.any? %>
  <div id="error_explanation">
    <% @event.errors.full_messages.each do |msg| %>
      <div class="alert alert-danger">
        <%= msg %>
      </div>
    <% end %>
  </div>
  <div class="alert alert-danger">
    Prosím, řekni nám o této chybě na pikomat@mff.cuni.cz.
  </div>
<% end %>


<% @participants_all.each do |participant| %>
  <% if participant.errors.any? %>
    <div id="error_explanation">
      <% participant.errors.full_messages.each do |msg| %>
        <div class="alert alert-danger">
          <%= msg %>
        </div>
      <% end %>
    </div>
    <div class="alert alert-danger">
      Prosím, řekni nám o této chybě na pikomat@mff.cuni.cz.
    </div>
  <% end %>
<% end %>

<p><%= @event.body %><p>

<p><b>Datum: <%= @event.date_str %></b><p>

<% if @event.limit_num_participants %>
  Na tuto akci může jet maximálně <b><%= @event.max_participants %></b> účastníků. Aktuálně je <%= @num_p_yes %> přihlášených a <%= @num_s_yes %> náhradníků.
<% end %>

<% if @event.event_info_url != "" %>
  <p>Přečti si <a href="<%= @event.event_info_url %>">další informace!</a></p>
<% end %>

<% if ((! @already_happened) && (! @edit_participants)) %>
  <% if Act::Participant::has_participant?(current_user) && @event.fulfils_activation?(current_user.participant) %>
    <% if @event.can_participate?(current_user.participant) %>
      <%= render :partial => "act/events/form_enroll", :locals => { :chosen => "participant" } %>
    <% elsif @event.can_substitute?(current_user.participant) %>
      <%= render :partial => "act/events/form_enroll", :locals => { :chosen => "substitute" } %>
    <% else %>
      <div class="alert alert-warning">
        Bohužel jsi nebyl vybrán ani mezi účastníky, ani mezi náhradníky. Tedy se na tuto akci nemůžeš přihlásit.
        Pokud si myslíš, že se jedná o chybu, neváhej nám napsat.
      </div>
    <% end %>
  <% elsif Act::Participant::has_participant?(current_user) && ! @event.fulfils_activation?(current_user.participant) %>
    <div class="alert alert-warning">
      Aby ses mohl/a přihlásit na tuto akci, musíš mít plně aktivovaný <%= link_to "účastnický účet", act_participant_path(current_user.participant) %> (částečně to nestačí).
      Účet si aktivuješ tak, že do něj vyplníš všechny potřebné informace a klikneš na tlačítko <i>Uložit</i>.
    </div>
  <% else %>
    <div class="alert alert-warning">
      Abys ses mohl/a přihlásit na nějakou akci, musíš mít založený účastnický účet, a navíc ještě musíš být přihlášený/á. Tak neváhej, a účastnický účet si
      <%= link_to "založ!", act_participant_new_path %>
    </div>
  <% end %>
<% end %>

<% show_substitutes = ! @event.open_for_everyone? || @substitutes_yes.length() > 0 || @substitutes_maybe.length() > 0 || @substitutes_no.length() > 0 %>

<div>
<% if can? :read_other, Act::Participant %>
  <p>
  <% if ! @edit_participants %>
    <%= button_tag "Zobraz hromadné informace", :href => act_event_display_participants_path(@event), :class => 'btn btn-info', :ico => 'fa-book' %>
  <% end %>
  </p>
<% end %>
<h2>Přihlášení účastníci <%=act_count_participiants(@parts_yes)%></h2>
<% if current_user %>
<table>
<%= render :partial => "act/events/event_participant_table_header", :locals => { :event => @event } %>
  <%= render @parts_yes %>
  <%= render @parts_maybe %>
  <%= render @parts_no %>
</table>
</div>

<% if show_substitutes %>
<div>

<h2>Přihlášení náhradníci <%=act_count_participiants(@substitutes_yes)%></h2>
<table>
<%= render :partial => "act/events/event_participant_table_header", :locals => { :event => @event } %>
    <%= render @substitutes_yes %>
    <%= render @substitutes_maybe %>
    <%= render @substitutes_no %>
</table>
<% end %>

<h2>Přihlášení orgové <%=act_count_participiants(@orgs_yes)%></h2>
<table>
<%= render :partial => "act/events/event_participant_table_header", :locals => { :event => @event } %>
  <%= render @orgs_yes %>
  <%= render @orgs_maybe %>
  <%= render @orgs_no %>
</table>
</div>
<% else %>
  Pro zobrazení účastníků je potřeba se přihlásit.
<% end %>

</div>
</div>
