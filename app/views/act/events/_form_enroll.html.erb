<% if @event.paper_template.present? %>
  <h2>Potřebné dokumenty</h2>

  Stáhni si potřebné <%= link_to "dokumenty k akci", act_event_my_papers_please_path(@event.id) %>.
  Dokumenty jsou předvyplněné, ale je nutné je vytisknout a podepsat. 
  Předvyplněné údaje je možné před vytištěním editovat, pokud jsou nepřesné.
<% end %>
<% if chosen == "participant" %>
  <h2>Přihláška</h2>
<% elsif chosen == "substitute" %>
  <h2>Přihláška pro náhradníka</h2>
<% else %>
  <h2>
    Vyskytla se chyba. Prosím, sděl nám, že jsi ji dostal.
    Chyba spočívá v tom, že proměnná "chosen" v _form_enroll nenabývá žádné z možných hodnot.
  </h2>
<% end %>

<%= form_for :event_participant, :url => { :action => :enroll } do |f| %>

  <% if @event_participant.errors.any? %>
    <div id="error_explanation">
      <% @event_participant.errors.full_messages.each do |msg| %>
        <div class="alert alert-danger">
          <%= msg %>
        </div>
      <% end %>
    </div>
    <div class="alert alert-danger">
      Prosím, řekni nám o této chybě na pikomat@mff.cuni.cz.
    </div>
  <% end %>

  <%= f.hidden_field :event_id, value: @event.id %>

  <%= f.hidden_field :participant_id, value: Act::Participant::participant_id(current_user) %>

  <%= f.hidden_field :chosen, value: chosen %>

  <b>
  <%= f.select :status, [["půjdu", "yes"], ["možná", "maybe"], ["nezúčastním se", "no"]] %>
  </b>
  <p>
  <%= f.label :note, "Poznámky (veřejné):" %><br>
    <%= f.text_field :note %>
  </p>

  <% if @event.spec_place %>
    <p>
      <%= f.label :place, "Nastupuji v " %>
      <%= f.select :place, @event.spec_place_detail.split(',') %>
    </p>
  <% else %>
    <%= f.hidden_field :place %>
  <% end %>

  <% if @event.spec_participant %>
    <p>
    <%= f.label :participant_info, "Na co chci u svého dítěte upozornit (neveřejné): " %><br>
      <%= f.text_field :participant_info %>
    </p>
  <% else %>
    <%= f.hidden_field :participant_info %>
  <% end %>

  <% if @event.spec_mass %>
    <p>
      <%= f.label :mass, "Dítě na nedělení mši " %>
      <%= f.select :mass, [["chce", true], ["nechce", false]] %>
    </p>
  <% else %>
    <%= f.hidden_field :mass %>
  <% end %>

  <b>Zkontrolujte si, že všechny informace uvedené ve vašem <%= link_to "účastnickém profilu", act_participant_path(current_user.participant), :target => '_blank' %> jsou aktuální!</b>

  <p>
    <% if Act::EventParticipant::chosen(@event, Act::Participant::get_participant(current_user)) == "none" %>
      <%= f.submit "Uložit přihlášku", :class => 'btn btn-primary' %>
    <% else %>
      <%= f.submit "Změnit přihlášku", :class => 'btn btn-primary' %>
    <% end %>
  </p>
<% end %>
