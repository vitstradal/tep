<%= render 'tabs_edit' do %>

<h1>Historie účastníků <%= @event.title %></h1>

<form method="get" style="margin:.5rem 0">
  <%# zaškrtnuto (default, bez parametru) = jen akce stejné skupiny; hidden
      zajistí all=1 při odškrtnutí — checkbox ho svou hodnotou přebije %>
  <input type="hidden" name="all" value="1">
  <label class="checkbox-inline">
    <input type="checkbox" name="all" value="0" <%= 'checked' unless @history_all %>
           onchange="this.form.submit()">
    Jen <%= @event.long_term? ? 'dlouhodobé' : 'krátkodobé' %> akce
  </label>
</form>

<% if @history_people.empty? %>
  <p>Na akci zatím není nikdo přihlášený.</p>
<% elsif @history_events.empty? %>
  <p>Nikdo z přihlášených zatím nebyl na žádné jiné
     <%= @history_all ? '' : (@event.long_term? ? 'dlouhodobé ' : 'krátkodobé ') %>akci.</p>
<% else %>
  <style>
    /* zvýraznění řádku a sloupce pod myší (sloupec přes .col-hl z JS) */
    #history-table tbody tr:hover td { background: #d9edf7; }
    #history-table td.col-hl, #history-table th.col-hl { background: #d9edf7; }
  </style>
  <table id="history-table" class="table table-striped table-bordered" style="width:auto">
    <thead>
      <tr>
        <th>Jméno</th>
        <th>Příjmení</th>
        <th>Ročník</th>
        <% @history_events.each do |e| %>
          <th style="vertical-align:bottom;padding:8px 4px" title="<%= e.title %><%= e.event_start ? " (#{e.event_start})" : '' %>">
            <span style="writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap;font-weight:normal">
              <%= link_to e.title, act_event_path(e) %>
            </span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @history_people.each do |p| %>
        <tr>
          <td><%= p.name %></td>
          <td><%= p.last_name %></td>
          <td><%= p.grade %></td>
          <% @history_events.each do |e| %>
            <td style="text-align:center">
              <% if @history_att[[p.id, e.id]] %><strong title="byl na akci">*</strong><% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <script>
    // zvýrazni celý sloupec, nad kterým je myš (řádek řeší CSS :hover)
    document.addEventListener('DOMContentLoaded', function () {
      var table = document.getElementById('history-table');
      if (!table) return;
      function colCells(idx) {
        return table.querySelectorAll('tr > *:nth-child(' + (idx + 1) + ')');
      }
      table.addEventListener('mouseover', function (ev) {
        var cell = ev.target.closest('td, th');
        if (!cell || !table.contains(cell)) return;
        table.querySelectorAll('.col-hl').forEach(function (c) { c.classList.remove('col-hl'); });
        colCells(cell.cellIndex).forEach(function (c) { c.classList.add('col-hl'); });
      });
      table.addEventListener('mouseleave', function () {
        table.querySelectorAll('.col-hl').forEach(function (c) { c.classList.remove('col-hl'); });
      });
    });
  </script>
<% end %>

<% end %>
