<%= render 'tabs_edit' do %>

<h1>Historie účastníků <%= @event.title %></h1>

<form method="get" style="margin:.5rem 0">
  <%# zaškrtnuto (default, bez parametru) = jen akce stejné skupiny; hidden
      zajistí all=1 při odškrtnutí — checkbox ho svou hodnotou přebije %>
  <input type="hidden" name="all" value="1">
  <label class="checkbox-inline">
    <input type="checkbox" name="all" value="0" <%= 'checked' unless @history_all %>
           onchange="this.form.submit()">
    Jen <%= @event.long_term? ? 'dlouhodobé' : 'krátkodobé' %> akce
  </label>
</form>

<% if @history_people.empty? %>
  <p>Na akci zatím není nikdo přihlášený.</p>
<% elsif @history_events.empty? %>
  <p>Nikdo z přihlášených zatím nebyl na žádné jiné
     <%= @history_all ? '' : (@event.long_term? ? 'dlouhodobé ' : 'krátkodobé ') %>akci.</p>
<% else %>
  <p class="text-muted" style="margin-bottom:.5rem">
    <i class="ace-icon fa fa-flag green"></i> org &nbsp;
    <i class="ace-icon fa fa-user blue"></i> účastník &nbsp;
    <strong>*</strong> = byl (role nezjištěna) &nbsp;
    prázdné = nebyl
  </p>
  <style>
    /* zvýraznění řádku a sloupce pod myší (sloupec přes .col-hl z JS) */
    #history-table tbody tr:hover td { background: #d9edf7; }
    #history-table td.col-hl, #history-table th.col-hl { background: #d9edf7; }
  </style>
  <table id="history-table" class="table table-striped table-bordered" style="width:auto">
    <thead>
      <tr>
        <th>Jméno</th>
        <th>Příjmení</th>
        <th>Ročník</th>
        <% @history_events.each do |e| %>
          <th style="vertical-align:bottom;padding:8px 4px" title="<%= e.title %><%= e.event_start ? " (#{e.event_start})" : '' %>">
            <span style="writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap;font-weight:normal">
              <%= link_to e.title, act_event_path(e) %>
            </span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @history_people.each do |p| %>
        <tr>
          <td><%= p.name %></td>
          <td><%= p.last_name %></td>
          <td><%= p.grade %></td>
          <% @history_events.each do |e| %>
            <% ep = @history_att[[p.id, e.id]] %>
            <% hint = "#{p.name} #{p.last_name} · #{e.title}#{e.event_start ? " (#{e.event_start})" : ''} — " %>
            <% hint += if ep.nil? then 'nebyl'
                       elsif ep.role_display == 'org' then 'org'
                       elsif ep.role_display == 'participant' then 'účastník'
                       else 'byl (role nezjištěna)'
                       end %>
            <% hint += ' (odhad podle ročníku)' if ep && ep.role_guessed? %>
            <td style="text-align:center" data-hint="<%= hint %>">
              <% if ep %>
                <% guessed = ep.role_guessed? %>
                <% if ep.role_display == 'org' %>
                  <i class="ace-icon fa fa-flag green" title="org<%= ' (odhad podle ročníku)' if guessed %>"></i>
                <% elsif ep.role_display == 'participant' %>
                  <i class="ace-icon fa fa-user blue" title="účastník<%= ' (odhad podle ročníku)' if guessed %>"></i>
                <% else %>
                  <strong title="byl na akci (role nezjištěna)">*</strong>
                <% end %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%# falešný stavový řádek prohlížeče (do window.status už JS psát nesmí) %>
  <div id="history-statusbar"
       style="display:none;position:fixed;left:0;bottom:0;z-index:99;max-width:85%;
              background:#f5f5f5;border:1px solid #bbb;border-left:0;border-bottom:0;
              border-radius:0 4px 0 0;padding:2px 10px;font-size:.85em;color:#333;
              white-space:nowrap;overflow:hidden;text-overflow:ellipsis"></div>
  <script>
    // zvýrazni celý sloupec, nad kterým je myš (řádek řeší CSS :hover)
    // + ukaž info o buňce ve „stavovém řádku" v rohu
    document.addEventListener('DOMContentLoaded', function () {
      var table = document.getElementById('history-table');
      var bar = document.getElementById('history-statusbar');
      if (!table) return;
      function colCells(idx) {
        return table.querySelectorAll('tr > *:nth-child(' + (idx + 1) + ')');
      }
      table.addEventListener('mouseover', function (ev) {
        var cell = ev.target.closest('td, th');
        if (!cell || !table.contains(cell)) return;
        table.querySelectorAll('.col-hl').forEach(function (c) { c.classList.remove('col-hl'); });
        colCells(cell.cellIndex).forEach(function (c) { c.classList.add('col-hl'); });
        var hint = cell.getAttribute('data-hint');
        if (hint) { bar.textContent = hint; bar.style.display = 'block'; }
        else { bar.style.display = 'none'; }
      });
      table.addEventListener('mouseleave', function () {
        table.querySelectorAll('.col-hl').forEach(function (c) { c.classList.remove('col-hl'); });
        bar.style.display = 'none';
      });
    });
  </script>
<% end %>

<% end %>
