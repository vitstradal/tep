<style>
  .adv-kontrola-day img { max-width: 100%; height: auto; }
  .adv-kontrola-day hr { margin: 6px 0; }
</style>

<h1>Kontrola: <%= @game.title %></h1>

<p>
  <%= link_to "/piki/adventomat/#{@game.year}" do %><i class="fa fa-pencil"></i> zadání v piki<% end %> ·
  <%= link_to adventomat_review_path(name: @game.quiz_name) do %><i class="fa fa-eye"></i> review příkladů<% end %> ·
  <%= link_to "/adventomat/#{@game.year}" do %><i class="fa fa-calendar"></i> kalendář na webu<% end %>
  (debug mód zapneš v liště pod kalendářem)
</p>

<% if @issues.empty? %>
  <div class="alert alert-success">Všechny dny jsou v pořádku.</div>
<% else %>
  <table class="table table-condensed table-bordered" style="width:auto">
    <tr><th>Den</th><th>Problém</th></tr>
    <% @issues.each do |i| %>
      <tr class="<%= i[:level] == :error ? 'danger' : 'warning' %>">
        <td><%= i[:day] == Adventomat::BONUS ? 'bonus' : i[:day] == :reward ? 'odměna' : i[:day] || 'hlavička' %></td>
        <td><%= i[:text] %></td>
      </tr>
    <% end %>
  </table>
<% end %>

<table class="table table-condensed table-bordered">
  <tr><th>Den</th><th>Otevře se</th><th>Zadání / výsledek / poznámka</th></tr>
  <% (1..Adventomat::BONUS).each do |n| %>
    <% day = @game.days[n] %>
    <tr class="<%= 'danger' if day.nil? && n < Adventomat::BONUS %>">
      <th><%= n == Adventomat::BONUS ? 'bonus' : n %></th>
      <td style="white-space:nowrap"><%= l(@game.open_at(n), format: '%-d. %-m. %Y %H:%M') rescue @game.open_at(n).strftime('%-d. %-m. %Y %H:%M') %></td>
      <% if day %>
        <td class="adv-kontrola-day">
          <%= raw preview_html(@game.day_html(n)) %>
          <hr/>
          <span class="<%= 'red' if day.result.nil? %>"><%= day.result_raw.presence || 'chybí výsledek' %></span>
          <% if day.note.present? %>
            <hr/>
            <%= day.note %>
          <% end %>
        </td>
      <% else %>
        <td><i><%= n == Adventomat::BONUS ? 'bez bonusu' : 'chybí' %></i></td>
      <% end %>
    </tr>
  <% end %>
  <tr>
    <th>odměna</th><td></td>
    <td class="adv-kontrola-day"><%= @game.reward ? raw(preview_html(@game.reward_html)) : content_tag(:i, 'bez odměny') %></td>
  </tr>
</table>
