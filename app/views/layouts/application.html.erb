                  <li>
                    <%= form_tag view_as_toggle_path, method: :post, style: 'margin:0' do %>
                      <button type="submit" class="btn btn-link" style="width:100%;text-align:left" title="Přepínač u drobečkové navigace: náhled stránky s menšími právy">
                        <i class="ace-icon fa <%= view_as_switch? ? 'fa-check-square-o' : 'fa-square-o' %>"></i> Přepínač „Jak to vidí“
                      </button>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
            <li><%= ilink_to  'Logout', :destroy_user_session , :ico => 'fa-sign-out', :class => 'btn tep-transparent' %></li>
            <script>window.tep_signed_in = true;</script>
          <% else %>
            <%# widget přítele Pikomatu — 4 stavy, řídí init_friend_widget() v tep.js
                (viz navrh-kvizy-a-pratele.md) %>
