<%# cesta %>
<%################################################################################## %>

  <%#
    # struktura @breadcumb
    # [ cast1, cast2, cast3 ]
    # cast1 : [ item1, item2, item2, ... ]
    # item:
    #        { name: "Série #{round}",
    #          active: true|false,
    #          url: url_for(roc: annual, se: round),
    #          sub: [ {name:"", url:""} , ...  ] # vyrolovaci menu
    #        }
    #%>
  <% crumbs = @breadcrumb || menu_breadcrumb %>
  <% if crumbs %>
    <div id="breadcrumbs" class="breadcrumbs no-print">
<%################################################################################## %>
<%# akcni tlacitka %>
<%################################################################################## %>
       <%= yield :action_buttons %>
       <%= render 'layouts/view_as' %>
       <ul class="breadcrumb">
         <% crumbs.each_with_index do |b, idx| %>
           <% b.each_with_index do |bread| %>
             <% if ! bread[:active] || true %>
               <li class="<%= idx == 0 ? 'tep-slash' : ''%>">
                 <% if bread[:ico] %><i class="fa <%= bread[:ico] %> home-icon"></i><% end %>
                 <% if bread[:sub] %>
                   <div class="inline pos-rel">
                     <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                     <%= bread[:raw] ? bread[:name] : bread[:name].to_s.upcase_first %>
                     <i class="fa fa-caret-down"></i></a>
                     <ul class="dropdown-menu dropdown-light dropdown-caret dropdown-closer">
                       <% bread[:sub].each do |bread2| %>
                         <li><%=link_to  bread[:raw] ? bread2[:name] : bread2[:name].to_s.upcase_first, bread2[:url] %></li>
                       <% end %>
                     </ul>
                   </div>
                 <% else %>
                   <%=link_to  bread[:raw] ? bread[:name] : bread[:name].to_s.upcase_first, bread[:url] %>
                 <% end %>
               </li>
             <% elsif bread[:name] !~  /^index$/i %>
               <li> <%=  bread[:name].to_s.upcase_first %></li>
             <% end %>
           <% end %>
         <% end %>
       </ul>
       <div style='padding-left:12px' id="page-content-top2"></div>
     </div><%#breadcrumb %>
   <% elsif view_as_switch? %>
     <div class="clearfix no-print"><%= render 'layouts/view_as' %></div>
   <% end %>


   <div class="page-content">

     <div class="row">
       <div id="page-content-top" class="col-xs-12">
<%################################################################################## %>
<%# alerty %>
<%################################################################################## %>
        <% if flash[:alerts] %>
          <% flash[:alerts].each do |msg| %>
            <div class="alert alert-danger"> <%= msg %> </div>
          <% end %>
        <% end %>
        <% if flash[:success] %>
          <% flash[:success].each do |msg| %>
            <div class="alert alert-success"> <%=msg %> </div>
          <% end %>
        <% end %>
<%################################################################################## %>
<%# bannery %>
<%################################################################################## %>
        <% show_banner = false %>
        <% show_banner ||= true if @config[:show_banner] == 'yes'  %>
        <% show_banner ||= user_signed_in?  if @config[:show_banner_to_user] == 'yes'   %>
        <% if show_banner %>
          <% if cookies['hide_banner'.to_sym] != '1' %>
            <div class="alert alert-danger">
              <button type="button" class="banner close" data-dismiss="alert">
                <i class="ace-icon fa fa-times"></i>
              </button>
                <%== wiki2html( @config[:banner] ) %>
            </div>
          <% else %>
            .
          <% end %>
        <% end %>
<%################################################################################## %>
<%# taby akci
<%################################################################################## %>
        <% @event = maybe_get_act_event %>
        <% if @event && !@event.id.nil? %>
          <div class="tabbable">
            <ul id="myTab" class="nav nav-tabs">
               <%######################### tab Infromace -%>
                  <li <%=class_active_if( @event_tab == 'info') %>> <%=ilink_to 'Informace', @event.event_info_url.presence || act_event_info_path(@event), ico: 'fa-book', title: 'Vidí každý, kdo vidí akci' %></li>

               <%######################### tab Přihlašování -%>
               <% if @event.enrollment_visible?(current_user) -%>
                  <li <%=class_active_if( @event_tab == 'show') %>> <%=ilink_to 'Přihlašování', act_event_path(@event), ico: 'fa-pencil-square-o', title: "Orgové vždy, ostatní do #{Act::Event::ENROLL_VISIBLE_DAYS_AFTER_END} dnů po konci akce" %></li>
               <% end -%>

               <%######################### tab Lidé -%>
               <% if @event.people_visible?(current_user) -%>
                  <li <%=class_active_if( @event_tab == 'people') %>> <%=ilink_to 'Lidé', act_event_people_path(@event), ico: 'fa-users', title: 'Orgové vždy, ostatní když je někdo přihlášený' %></li>
               <% end -%>

               <%######################### tab Dokumenty -%>
               <% if @event.documents_visible?(current_user) -%>
                  <li <%=class_active_if( @event_tab == 'docs') %>> <%=ilink_to 'Dokumenty', act_event_documents_path(@event), ico: 'fa-file-text-o', title: 'Každý, když jsou k akci nastavené papíry' %></li>
               <% end -%>

               <%######################### tab Fotky %>
               <% if @event.event_photos_url != "" -%>
                  <li <%=class_active_if( @event_tab == 'foto') %>> <%=ilink_to 'Fotky', @event.event_photos_url, ico: 'fa-photo', title: 'Vidí každý, kdo vidí akci' %></li>
               <% end -%>

               <%######################### tab Orgove -%>
               <% if !current_user.nil? && current_user.org? -%>

                 <%######################### tab Edituj akci -%>
                 <li class="act_margin_enroll_others <%=active %w(edit edit-inv edit-par enroll).include?(@event_tab)%>">
                     <%=ilink_to act_event_edit_path(@event), ico:'fa-cogs', title: 'Vidí org, měnit může jen morg' do  %>Nastavení akce<%end%>
                 </li>

                 <%######################### tab Seznam -%>
                 <% if can? :display_participants, Act::Event -%>
                   <li <%=class_active_if( @event_tab == 'list') %>><%= ilink_to act_event_display_participants_path(@event), ico: 'fa-list', title: 'Jen morg' do%>Seznam<%end%> </li>
                 <% else -%>
                   <%= disabled_li 'Seznam', ico: 'fa-list', tab: true %>
                 <% end -%>

                 <%######################### tab Piki -%>
                 <% if @event.event_piki_url != ""  -%>
                    <li <%=class_active_if( @event_tab == 'piki') %>> <%=ilink_to @event.event_piki_url, ico: 'fa-flask', title: 'Jen org' do %>Piki<%end%></li>
                 <% end -%>
                 <%######################### tab Sklep -%>
                 <% if @event.event_sklep_url != ""  -%>
                    <li <%=class_active_if( @event_tab == 'sklep') %>> <%=ilink_to @event.event_sklep_url, ico: 'fa-cube', title: 'Jen org' do %>Sklep<%end%></li>
                 <% end -%>
               <% end -%>
            </ul>
            <div class="tab-content">
       <% end %>
<%################################################################################## %>
<%# obsah stranky %>
<%################################################################################## %>
              <%= yield %>
        <% if @event %>
             </div>
           </div>
        <% end %>


       </div><!-- /.col -->
     </div><!-- /.row -->
   </div><!-- /.page-content -->

  </div><!-- /.main-content -->

