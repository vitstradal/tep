
<h1>Uživatel  <%= @user.email %> - editace</h1>

<div class="tabbable">
  <ul id="myTab" class="nav nav-tabs">
     <li <%=class_active_if(@tab=='config')%>> <%= link_to 'Nastavení',    '#config', 'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='group' )%>> <%= link_to 'Skupiny',      '#group',  'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='solver')%>> <%= link_to 'Řešitel',      '#solver', 'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='participant')%>> <%= link_to 'Účastník',         '#participant', 'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='mail'  )%>> <%= link_to 'Maily',        '#mail',   'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='password')%>> <%= link_to 'Heslo',        '#password',   'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='email' )%>> <%= link_to 'Změna emailu', '#email',  'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='jabber')%>> <%= link_to 'Jabber',       '#jabber',  'data-toggle' => 'tab' %></li>
     <li <%=class_active_if(@tab=='remove')%>> <%= link_to 'Smazat',       '#remove', 'data-toggle' => 'tab' %></li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane <%=active_in_if(@tab=='config')%>" id='config'>

      <%= form_for @user, url: user_update_path(@user.id), html: {:class=>'form-horizontal'} do |f| %>
          <div class="control-group">
            <label class="control-label" for="user[email]">Email (pro změnu bude vyžadována konfirmace)</label>
            <div class="controls"> <%= f.text_field :email %> </div>
          </div>
      
          <div class="control-group">
            <label class="control-label" for="user[name]">Jméno</label>
            <div class="controls"> <%= f.text_field :name %> </div>
          </div>
      
          <div class="control-group">
            <label class="control-label" for="user[last_name]">Příjmení</label>
            <div class="controls"> <%= f.text_field :last_name %> </div>
          </div>
      
          <div class="control-group">
             <div class="controls">
               <%= f.submit 'Uložit', :class=>'btn btn-primary'%>
             </div>
          </div>
      <% end %>
    </div> <%# tab-pane %>
    <div class="tab-pane <%=active_in_if(@tab=='group')%>" id='group'>
      Skupiny:Uživatel 
      <ul>
        <% @user.roles.each do |role|%>
           <li><%= role %></li>
        <% end.empty? and begin %>
          <li><i> tento uživatel nemá žádné skupiny</i></li>
        <% end %>
      </ul>
      <%= form_for @user, url: user_role_change_path(@user.id), :html => {:class => 'form-inline' } do |f| %>
          <%= f.hidden_field :id %>
          <%= select_tag :role, 
             options_for_select( User.valid_roles.reverse.map { |r| (@user.has_role? r) ? "-#{r}" : "+#{r}" }),
             :class => 'input-small'
             %>
          <%= f.submit value: 'Přidat/odebrat skupinu'%>
      <% end %>
    </div> <%# tab-pane %>
    <div class="tab-pane <%=active_in_if(@tab=='solver')%>" id='solver'>
      Řešitelé:
      <ul>
        <% @solvers.each do |solver| %>
           <li><%= solver.name %>
               <%= solver.last_name %>
               <%= link_to "id#{solver.id}", sosna_solver_url(solver.id)%>
               (roč<%= solver.annual %>)
            </li>
        <% end.empty? and begin %>
          <li><i> tento uživatel nemá řešitele</i></li>
        <% end %>
      </ul>
    </div> <%# tab-pane %>

    <div class="tab-pane <%=active_in_if(@tab=='participant')%>" id='participant'>
      <% if Act::Participant::has_participant?(@user) %>
        <%= render :partial => "act/participants/form_edit", locals: { is_edit: true, participant: @user.participant } %>
        <%= render partial: "act/participants/button_delete", locals: { participant: @user.participant } %>
      <% else %>
        <i> Tento uživatel účastnický účet nemá.</i><br>
        <%= form_tag act_participant_create_other_path, method: :post do %>
          <%= hidden_field_tag :user_id, @user.id %>
          <%= hidden_field_tag :path, user_show_path(@user) %>
          <%= submit_tag "Založit účet" %>
        <% end %>
      <% end %>
    </div> <%# tab-pane %>

    <div class="tab-pane <%=active_in_if(@tab=='remove')%>" id='remove'>
      <%= form_tag user_delete_path(id:@user.id) do %>
         <%= submit_tag  'Smazat uživatele (nebude žádné "jsi si jistý?")', :class=>'btn btn-danger' %>
      <% end %>
    </div> <%# tab-pane %>
    <div class="tab-pane <%=active_in_if(@tab=='password')%>" id='password'>
      <%= form_tag user_set_password_path(id:@user.id) do %>
          <div class="control-group">
            <label class="control-label" for="password">
              Nové heslo uživatele, je třeba mu ho doručit třetí cestou.
              <a id='password_copy' class='btn'>Kopíruj</a>
              <a id='password_generate' class='btn'>Generuj náhodné heslo</a>
              </label>
            <div class="controls"> <%=text_field_tag(:password_input, '', size: 50) %> </div>
          </div>
          <%= submit_tag  'Nastav heslo', :class=>'btn btn-danger' %>
      <% end %>
    </div> <%# tab-pane %>
    <div class="tab-pane <%=active_in_if(@tab=='mail')%>" id='mail'>
      <hr/>
      <%= form_tag user_action_path(@user.id, :send_first_email), html: {:class=>'form-horizontal'} do %>
               <%= submit_tag 'Poslat uvítací email', :class=>'btn btn-danger'%>
      <% end %>
      
      <hr/>
      <%= form_tag user_action_path(@user.id, :send_password_reset), html: {:class=>'form-horizontal'} do %>
               <%= submit_tag 'Poslat reset hesla', :class=>'btn btn-danger'%>
      <% end %>
      <hr/>
      <% @resource = @user %>
      <h2>Náhled mailů pro tohoto uživatele</h2>

      <h3>tep/mailer/first_login_instructions.html.erb</h3>
      <div class="well"> <%= render file: Rails.root.join('app/views/tep/mailer/first_login_instructions.html.erb') %></div>
      
      <h3>tep/mailer/reset_password_instructions.html.erb</h3>
      <div class="well"> <%= render file: Rails.root.join('app/views/tep/mailer/reset_password_instructions.html.erb') %></div>
      
      <h3>tep/mailer/unlock_instructions.html.erb</h3>
      <div class="well"> <%= render file:  Rails.root.join('app/views/tep/mailer/unlock_instructions.html.erb') %></div>
      
      <h3>confirmation_instructions.html.erb</h3>
      <div class="well"> <%= render file: Rails.root.join('app/views/tep/mailer/confirmation_instructions.html.erb') %></div>


    </div> <%# tab-pane %>
    <div class="tab-pane <%=active_in_if(@tab=='email')%>" id='email'>
      <div class="alert alert-danger">
        <strong>Pozor:</strong> tato změna je <strong>nevratná</strong> a obejde
        e-mailovou konfirmaci (Devise). Email se přepíše napřímo na zaškrtnutých
        místech. Pokud je nový email použit někde jinde, změna se neprovede.
      </div>

      <%= form_tag user_change_email_path(@user.id), html: {:class=>'form-horizontal'} do %>
          <div class="control-group">
            <label class="control-label" for="email">Nový email</label>
            <div class="controls"> <%= text_field_tag :email, @user.email, size: 50 %> </div>
          </div>

          <p>Místa, kde se má email přepsat:</p>
          <ul style="list-style:none">
            <li>
              <label class="checkbox">
                <%= check_box_tag 'user_account', '1', true, disabled: true %>
                Uživatelský účet (přihlášení) — <code><%= @user.email %></code>
                <i>(mění se vždy)</i>
              </label>
            </li>
            <% @solvers.each do |solver| %>
              <li>
                <label class="checkbox">
                  <%= check_box_tag 'solver_ids[]', solver.id, solver.email.to_s.casecmp(@user.email.to_s) == 0 %>
                  Řešitel ročníku <%= solver.annual %> (<%= solver.full_name %>) — <code><%= solver.email %></code>
                </label>
              </li>
            <% end %>
            <% if @user.participant %>
              <li>
                <label class="checkbox">
                  <%= check_box_tag :change_participant, '1', @user.participant.email.to_s.casecmp(@user.email.to_s) == 0 %>
                  Účastník akcí — <code><%= @user.participant.email %></code>
                </label>
              </li>
            <% end %>
          </ul>

          <div class="control-group">
             <div class="controls">
               <%= submit_tag 'Změnit email (nevratné)', :class=>'btn btn-danger', data: { confirm: 'Opravdu nevratně změnit email tohoto uživatele?' } %>
             </div>
          </div>
      <% end %>

      <hr/>
      <h4>Mattermost</h4>
      <p>
        Tato změna v tepu <strong>nemění</strong> email v Mattermostu – ten má
        vlastní databázi. Tam je potřeba ho přepsat <strong>ručně</strong> na
        produkčním serveru (jako root, přes <code>psql</code>). Tep to sám nespouští,
        tohle je jen ukázka příkazu:
      </p>
      <pre>tools/mattermost-change-email.sh <%= @user.email %> <span id="mm_new_email">&lt;NOVÝ_EMAIL&gt;</span></pre>
      <p class="muted">
        Skript je v repozitáři: <code>tools/mattermost-change-email.sh</code>.
        Přepíše i <code>@username</code> (odvozený z emailu) a je idempotentní –
        když ho pustíš podruhé, jen dopřejmenuje. Po změně je vhodné Mattermost
        restartovat (kvůli cache), případně použít <code>mmctl user edit&nbsp;…</code>.
      </p>
      <script>
        (function(){
          var inp = document.getElementById('email');
          var out = document.getElementById('mm_new_email');
          if (inp && out) {
            inp.addEventListener('input', function(){
              out.textContent = inp.value || '<NOVÝ_EMAIL>';
            });
          }
        })();
      </script>
    </div> <%# tab-pane %>
    <div class="tab-pane <%=active_in_if(@tab=='jabber')%>" id='jabber'>
        <% if @user.jabber? %>
          <% jabber = @user.jabber %>
          <% if !jabber.nil? %>
            <%= form_for jabber, url: jabber_update_path(jabber.id), html: {:class=>'form-horizontal'} do |f| %>
              <div class="control-group">
                <label class="control-label" for="jabber[jid]">JID address (musí končit @pikomat.mff.cuni.cz)</label>
                <div class="controls"> <%= f.text_field :jid %> </div>
              </div>
      
              <div class="control-group">
                <label class="control-label" for="jabber[nick]">Nick</label>
                <div class="controls"> <%= f.text_field :nick %> </div>
              </div>
      
              <div class="control-group">
                 <div class="controls">
                   <%= f.submit 'Update', :class=>'btn btn-primary'%>
                 </div>
              </div>
            <% end # form %>
            <hr/>
            <%= form_tag jabber_delete_path(jabber.id), html: {:class=>'form-horizontal'} do %>
              <div class="control-group">
                 <div class="controls">
                   <%= submit_tag 'Delete jabber', :class=>'btn btn-danger'%>
                 </div>
              </div>
            <% end %> 
          <% else # jabber.nil %>
            <%= form_tag jabber_new_path(@user.id), html: {:class=>'form-horizontal'} do |f| %>
              <div class="control-group">
                 <div class="controls">
                   <%= submit_tag 'Create jabber', :class=>'btn btn-primary'%>
                 </div>
              </div>
            <% end %> 
          <% end %>
        <% else %>
          tento uživatel musí být ve skupině <code>jabber</code>
        <% end %>
    </div> <%# tab-pane %>
  </div> <%# tab-content %>
