<h2>Přihlásit na jiném zařízení</h2>

<div id="device-login-keyboard"
     data-code-url="<%= device_login_approve_code_path %>"
     data-confirm-url="<%= device_login_approve_confirm_path %>"
     data-cancel-url="<%= device_login_approve_cancel_path %>"
     data-state-url="<%= device_login_approve_state_path %>">
  <div class="row">
  <div class="col-sm-8">
  <h4 class="device-login-heading">Zadej kód z druhého zařízení</h4>

  <div class="device-login-slots">
    <% 4.times do %>
      <span class="device-login-slot"></span>
    <% end %>
    <button type="button" class="btn btn-default device-login-clear" title="Smazat poslední obrázek"><svg class="device-login-backspace" viewBox="0 0 24 18" aria-hidden="true"><path d="M8 1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H8L1 9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M11 5l8 8M19 5l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Smazat</button>
  </div>

  <div class="device-login-message"></div>

  <div class="device-login-grid">
    <% DeviceLogin::ICONS.each_slice(4).with_index do |row, r| %>
      <div class="device-login-row">
        <% row.each_with_index do |(letter, emoji, name), c| %>
          <button type="button" class="btn btn-default device-login-key" data-i="<%= r * 4 + c %>" data-letter="<%= letter %>">
            <span class="device-login-letter"><%= letter %></span>
            <span class="device-login-emoji"><%= emoji %></span>
            <span class="device-login-name"><%= name %></span>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="device-login-confirm hide">
    <p class="device-login-device"></p>
    <p class="device-login-network"></p>
    <p class="device-login-age"></p>
    <p><strong>Potvrď, jen pokud to zařízení máš před sebou.</strong></p>
    <button type="button" class="btn btn-primary device-login-approve">Potvrdit</button>
    <button type="button" class="btn btn-default device-login-cancel">Zrušit</button>
  </div>

  <div class="device-login-wait hide">
    <p class="device-login-wait-text"></p>
    <button type="button" class="btn btn-default device-login-cancel">Zrušit</button>
  </div>

  <a class="btn btn-primary device-login-home hide" href="<%= root_path %>">Zpět na hlavní stránku</a>
  <button type="button" class="btn btn-default device-login-again hide">Zkusit znovu</button>
  </div>

  <div class="col-sm-4 device-login-side">
    <p>Na druhém zařízení otevři tuto adresu, nebo naskenuj QR kód (vede na stejné místo):</p>
    <p><%= link_to device_login_url, device_login_url %></p>
    <div class="device-login-qr" data-url="<%= device_login_url %>"></div>
    <p>Ukážou se ti tam 4 obrázky – zadej je sem.</p>
  </div>
  </div>
</div>

<%= javascript_include_tag '/javascripts/qrcode.js?v=1.4.4' %>

<noscript>
  <div class="alert alert-warning">Přihlášení na jiném zařízení potřebuje zapnutý JavaScript.</div>
</noscript>
