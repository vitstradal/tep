<h2>Přihlásit pomocí jiného zařízení</h2>

<div id="device-login-new"
     data-create-url="<%= device_login_vytvor_path %>"
     data-state-url="<%= device_login_stav_path %>"
     data-yes-url="<%= device_login_ano_path %>"
     data-no-url="<%= device_login_ne_path %>">
  <div class="device-login-icons"></div>
  <p class="device-login-help">Zadej tyto 4 obrázky na zařízení, kde jsi přihlášený, v menu „Přihlásit na jiném zařízení“.</p>
  <div class="device-login-message"></div>
  <p class="device-login-countdown"></p>
  <button type="button" class="btn btn-default device-login-renew">Nový kód</button>
</div>

<noscript>
  <div class="alert alert-warning">Přihlášení pomocí jiného zařízení potřebuje zapnutý JavaScript.</div>
</noscript>
